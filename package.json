{
  "name": "middlemen-rental-platform",
  "version": "0.1.0",
  "description": "Clean architecture bootstrap for a no-agent rental platform.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/infrastructure/db/runMigrations.js",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "dev:docker": "docker compose up --build",
    "migrate:reset": "docker compose down -v"
  },
  "keywords": [
    "clean-architecture",
    "nodejs",
    "postgresql",
    "redis",
    "rental-platform"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.41.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.6.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.21.0",
    "redis": "^5.1.5",
    "streamifier": "^0.1.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}