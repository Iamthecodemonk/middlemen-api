NODE_ENV=development
PORT=3000
APP_NAME=middlemen-rental-platform
LOG_ENABLED=true
LOG_LEVEL=info
MIGRATION_MAX_ATTEMPTS=10
MIGRATION_RETRY_DELAY_MS=3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=property_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/property_app

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
GOOGLE_CLIENT_ID=

TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_PIN_ATTEMPTS=3
TERMII_PIN_LENGTH=6

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=MiddleMan
SMTP_FROM_ADDRESS=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_UPLOAD_ATTEMPTS=3
IMAGE_UPLOAD_BACKOFF_MS=5000
IMAGE_UPLOAD_WORKER_CONCURRENCY=2
IMAGE_UPLOAD_REMOVE_ON_COMPLETE=100
IMAGE_UPLOAD_REMOVE_ON_FAIL=500

DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
KYC_LIVENESS_MAX_ATTEMPTS=3
KYC_LIVENESS_THRESHOLD=50
